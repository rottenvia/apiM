# Copy to deploy/.env on the server and fill in.
# This file holds the password to your app — never commit the real one.

# The password you type to sign in. Long, not reused anywhere else.
APP_PASSWORD=

# Signs session cookies. Any long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Your domain, e.g. apim.example.com  → HTTPS is automatic.
# No domain yet? Use  :80  and reach it at http://YOUR-SERVER-IP
# (plain HTTP means your API keys travel unencrypted — get a domain soon.)
SITE_ADDRESS=
