   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=2 debug=off\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
