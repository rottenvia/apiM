  {
   "name": "--config beats APP_CONFIG",
   "json": {
    "server": {
     "host": "10.0.0.5",
     "port": 9000,
     "workers": 3,
     "debug": false
    },
    "database": {
     "url": "mysql://u:pw@h/db",
