{
 "cases": [
  {
   "name": "defaults, no config file",
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=2 debug=off\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "full config",
   "json": {
    "server": {
     "host": "10.0.0.5",
     "port": 9000,
     "workers": 3,
     "debug": false
    },
    "database": {
     "url": "mysql://u:pw@h/db",
     "pool_size": 8,
     "timeout_seconds": 2
    },
    "features": {
     "enabled": [
      "Beta",
      " reports ",
      "beta"
     ],
     "beta_users": [
      "Z@x.io",
      "a@x.io",
      "z@x.io"
     ]
    },
    "logging": {
     "level": "error",
     "file": null
    }
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=10.0.0.5 port=9000 workers=3 debug=off\ndatabase: url=mysql://u:***@h/db pool=8 timeout=2.0s\nfeatures: beta, reports (beta users: 2)\nlogging: level=ERROR file=stderr\n"
   }
  },
  {
   "name": "env overrides win",
   "json": {
    "server": {
     "host": "10.0.0.5",
     "port": 9000,
     "workers": 3,
     "debug": false
    },
    "database": {
     "url": "mysql://u:pw@h/db",
     "pool_size": 8,
     "timeout_seconds": 2
    },
    "features": {
     "enabled": [
      "Beta",
      " reports ",
      "beta"
     ],
     "beta_users": [
      "Z@x.io",
      "a@x.io",
      "z@x.io"
     ]
    },
    "logging": {
     "level": "error",
     "file": null
    }
   },
   "env": {
    "APP_PORT": "9090",
    "DATABASE_URL": "postgres://x:y@z/w",
    "APP_FEATURES": " Search,EXPORT,,search ",
    "APP_LOG_FILE": "/tmp/x.log",
    "APP_HOST": "h.example"
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=h.example port=9090 workers=3 debug=off\ndatabase: url=postgres://x:***@z/w pool=8 timeout=2.0s\nfeatures: search, export (beta users: 2)\nlogging: level=ERROR file=/tmp/x.log\n"
   }
  },
  {
   "name": "empty env vars are ignored",
   "json": {
    "server": {
     "host": "10.0.0.5",
     "port": 9000,
     "workers": 3,
     "debug": false
    },
    "database": {
     "url": "mysql://u:pw@h/db",
     "pool_size": 8,
     "timeout_seconds": 2
    },
    "features": {
     "enabled": [
      "Beta",
      " reports ",
      "beta"
     ],
     "beta_users": [
      "Z@x.io",
      "a@x.io",
      "z@x.io"
     ]
    },
    "logging": {
     "level": "error",
     "file": null
    }
   },
   "env": {
    "APP_PORT": "",
    "APP_HOST": "",
    "APP_LOG_LEVEL": ""
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=10.0.0.5 port=9000 workers=3 debug=off\ndatabase: url=mysql://u:***@h/db pool=8 timeout=2.0s\nfeatures: beta, reports (beta users: 2)\nlogging: level=ERROR file=stderr\n"
   }
  },
  {
   "name": "debug implies DEBUG level",
   "json": {
    "server": {
     "debug": true
    }
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=2 debug=on\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=DEBUG file=stderr\n"
   }
  },
  {
   "name": "APP_DEBUG=on keeps explicit level",
   "json": {
    "logging": {
     "level": "info"
    }
   },
   "env": {
    "APP_DEBUG": "on"
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=2 debug=on\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "APP_DEBUG=off beats file",
   "json": {
    "server": {
     "debug": true
    }
   },
   "env": {
    "APP_DEBUG": "0"
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=2 debug=off\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "bad APP_DEBUG",
   "json": {},
   "env": {
    "APP_DEBUG": "maybe"
   },
   "expect": {
    "code": 2,
    "stdout": "",
    "stderr_has": "config error"
   }
  },
  {
   "name": "port out of range",
   "json": {
    "server": {
     "port": 70000
    }
   },
   "expect": {
    "code": 2,
    "stdout": "",
    "stderr_has": "config error"
   }
  },
  {
   "name": "bad APP_PORT",
   "env": {
    "APP_PORT": "80a"
   },
   "expect": {
    "code": 2,
    "stdout": "",
    "stderr_has": "config error"
   }
  },
  {
   "name": "workers auto from pool size",
   "json": {
    "server": {
     "workers": "auto"
    },
    "database": {
     "pool_size": 9
    }
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=4 debug=off\ndatabase: url=sqlite:///reports.db pool=9 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "APP_WORKERS=auto over a number",
   "json": {
    "server": {
     "workers": 7
    }
   },
   "env": {
    "APP_WORKERS": "auto",
    "APP_DB_POOL_SIZE": "20"
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=10 debug=off\ndatabase: url=sqlite:///reports.db pool=20 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "APP_WORKERS number over auto",
   "json": {
    "server": {
     "workers": "auto"
    }
   },
   "env": {
    "APP_WORKERS": "7"
   },
   "expect": {
    "code": 0,
    "stdout": "server: host=127.0.0.1 port=8000 workers=7 debug=off\ndatabase: url=sqlite:///reports.db pool=5 timeout=30.0s\nfeatures: none (beta users: 0)\nlogging: level=INFO file=stderr\n"
   }
  },
  {
   "name": "--config path",
   "json": {
    "server": {
     "host": "10.0.0.5",
     "port": 9000,
     "workers": 3,
     "debug": false
    },
    "database": {
     "url": "mysql://u:pw@h/db",
     "pool_size": 8,
     "timeout_seconds": 2
    },
    "features": {
     "enabled": [
      "Beta",
      " reports ",
      "beta"
     ],
