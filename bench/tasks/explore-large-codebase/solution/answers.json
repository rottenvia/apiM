{
  "audit_writer": {"file": "fleetdesk/storage/journal.py", "function": "JournalWriter.flush"},
  "webhook_backoff": {"config_key": "webhooks.delivery.backoff_initial_ms", "default": 500},
  "purge_expired_callers": [
    "fleetdesk/services/session_service.py:SessionService.validate",
