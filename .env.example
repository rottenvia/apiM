# Copy this file to `.env` and fill in your values.
#
# Postgres connection string, used for chat history.
# Optional: without it the app still runs and answers messages, but
# conversations are not saved and the sidebar history stays empty.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# GitHub OAuth connector. Create an OAuth App at:
# https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional separate encryption secret for the HttpOnly GitHub token cookie.
# Falls back to AUTH_SECRET, then GITHUB_CLIENT_SECRET.
GITHUB_TOKEN_SECRET=
# Set this when the public callback differs from the current site origin.
GITHUB_REDIRECT_URI=

# Optional deep executable decompilers used by inspect_binary.
# Built-in PE/import/DLL/string analysis works without either one.
# ILSpy: install with `dotnet tool install --global ilspycmd`; set this only
# when ilspycmd is not on PATH.
APIM_ILSPYCMD_PATH=
# Ghidra: path to the extracted folder containing support/analyzeHeadless(.bat).
APIM_GHIDRA_HOME=
# Heavy native analysis limits. Defaults: 4 minutes, up to 4 CPU cores, 100MB output.
APIM_BINARY_DECOMPILE_TIMEOUT_MS=240000
APIM_BINARY_MAX_CPU=4
APIM_BINARY_MAX_OUTPUT_MB=100
