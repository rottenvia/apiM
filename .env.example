# Optional — override the OpenCode Zen Chat Completions host.
# Defaults to https://opencode.ai/zen/v1 (Ox Alpha is x-preview-f-free).
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional — override the in-app Qwen sidecar (default 127.0.0.1:18765/v1).
# Download the 27B from Settings; this process never loads the weights.
# LOCAL_BASE_URL=http://127.0.0.1:18765/v1

# Copy this file to `.env` and fill in your values.
#
# Postgres connection string, used for chat history.
# Optional: without it the app still runs and answers messages, but
# conversations are not saved and the sidebar history stays empty.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# GitHub OAuth connector. Create an OAuth App at:
# https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional separate encryption secret for the HttpOnly GitHub token cookie.
# Falls back to AUTH_SECRET, then GITHUB_CLIENT_SECRET.
GITHUB_TOKEN_SECRET=
# Set this when the public callback differs from the current site origin.
GITHUB_REDIRECT_URI=

# Optional deep executable decompilers used by inspect_binary.
# Built-in PE/import/DLL/string analysis works without either one.
# ILSpy: install with `dotnet tool install --global ilspycmd`; set this only
# when ilspycmd is not on PATH.
APIM_ILSPYCMD_PATH=
# FLARE capa: optional path to capa.exe when it is not on PATH.
APIM_CAPA_PATH=
# A pip install contains the capa engine but NOT rules/signatures. Point these
# at matching capa-rules and capa/sigs checkouts. Relative paths are resolved
# from the apiM project. tools/capa-rules and tools/capa/sigs are auto-detected.
APIM_CAPA_RULES_PATH=
APIM_CAPA_SIGNATURES_PATH=
# Ghidra: path to the extracted folder containing support/analyzeHeadless(.bat).
APIM_GHIDRA_HOME=
# Heavy analysis limits. Defaults: 4 minutes, up to 4 CPU cores,
# 100MB decompiler output and 512MB exhaustive static/string output.
APIM_BINARY_DECOMPILE_TIMEOUT_MS=240000
# Caps Ghidra's automatic analysis before the focused post-script runs.
# Packed files default to 90s; other small files default to 120s.
APIM_GHIDRA_ANALYSIS_TIMEOUT_MS=120000
APIM_BINARY_MAX_CPU=4
APIM_BINARY_MAX_OUTPUT_MB=100
APIM_BINARY_MAX_STATIC_OUTPUT_MB=512
