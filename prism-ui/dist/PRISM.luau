		["esp.health.enabled"] = true,
		["esp.health.style"] = "Bar",
		["config.streamerMode"] = true,
	},
} :: { [string]: { [string]: any } }

function Schema.listProfiles(): { string }
	local names: { string } = {}
	for name, _ in Schema.PROFILES do
		table.insert(names, name)
	end
	table.sort(names)
	return names
