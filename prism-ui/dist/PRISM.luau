		["esp.maxDistance"] = 5000,
		["esp.targets"] = { "Players", "NPCs", "Items", "Vehicles" },
		["esp.boxes.enabled"] = true,
		["esp.boxes.style"] = "Filled3D",
		["esp.boxes.thickness"] = 2,
		["esp.names.enabled"] = true,
