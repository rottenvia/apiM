			return
		end
		self._open = true
		tokens = Theme.current()
		local s = services()
		lastHueRendered = -1
		lastStripRendered = ""
		nodes = {}

		root = el("Frame", {
			Name = "ColorPopup",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 300,
		}, overlay)
		local closer = el("TextButton", {
			Name = "Closer",
			Text = "",
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 300,
