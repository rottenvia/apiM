				Name = name .. "Grab",
				Text = "",
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Position = UDim2.fromOffset(0, -3),
				Size = UDim2.new(1, 0, 0, STRIP_H + 6),
				ZIndex = 303,
			}, box)
			y += STRIP_H + 8
			return box, grad, grab, cursor
		end

		local brightBox, brightGrad, brightGrab, brightCursor = makeStrip("Brightness")
		nodes.brightGrad = brightGrad
		nodes.brightCursor = brightCursor
		local alphaBox, alphaGrad, alphaGrab, alphaCursor = makeStrip("Alpha")
		nodes.alphaGrad = alphaGrad
		nodes.alphaCursor = alphaCursor

		-- -- Footer: old/new preview + hex --
		y += 2
		local oldSwatch = el("Frame", {
			Name = "OldSwatch",
			Position = UDim2.fromOffset(panelX(), y),
			Size = UDim2.fromOffset(40, 26),
			BackgroundColor3 = c3rgb(0.5, 0.5, 0.5),
			BorderSizePixel = 0,
			ZIndex = 302,
		}, card)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, oldSwatch)
		do
			local r, g, b = Color.hsvToRgb(value.h, value.s, value.v)
			local oldFill = el("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = c3rgb(r, g, b),
				BackgroundTransparency = 1 - value.a,
				BorderSizePixel = 0,
			}, oldSwatch)
			el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, oldFill)
		end
		local newSwatchBase = el("Frame", {
			Name = "NewSwatchBase",
			Position = UDim2.fromOffset(panelX() + 44, y),
			Size = UDim2.fromOffset(40, 26),
			BackgroundColor3 = c3rgb(0.5, 0.5, 0.5),
			BorderSizePixel = 0,
			ZIndex = 302,
		}, card)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, newSwatchBase)
		local newSwatch = el("Frame", {
			Name = "NewSwatch",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = c3rgb(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 303,
		}, newSwatchBase)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, newSwatch)
		nodes.newSwatch = newSwatch
		local hexBox = el("TextBox", {
			Name = "Hex",
			Position = UDim2.fromOffset(panelX() + 92, y),
			Size = UDim2.fromOffset(CONTENT_W - 92, 26),
			BackgroundColor3 = c3(tokens.bg2),
			BorderSizePixel = 0,
			Font = Enum.Font[tokens.fontMono],
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = c3(tokens.text),
			Text = "",
			ClearTextOnFocus = false,
			ZIndex = 302,
		}, card)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, hexBox)
		nodes.hexBox = hexBox
		nodes.hexTyping = false
		y += 30 + 10

		-- -- Palette rows --
		local paletteNames = Util.keys(Color.palettes)
		for _, pname in ipairs(paletteNames) do
			local px = panelX()
			for _, hex in ipairs(Color.palettes[pname]) do
				local parsed = Color.fromHex(hex)
				assert(parsed ~= nil, "ColorPicker: bad palette hex")
				local pc = parsed :: Color.RGBA
				local sw = el("TextButton", {
					Name = "PaletteSwatch",
					Text = "",
					AutoButtonColor = false,
					Position = UDim2.fromOffset(px, y),
					Size = UDim2.fromOffset(SWATCH, SWATCH),
					BackgroundColor3 = c3(hex),
					BorderSizePixel = 0,
					ZIndex = 302,
				}, card)
				el("UICorner", { CornerRadius = UDim.new(0, 4) }, sw)
				local ph, ps, pv = Color.rgbToHsv(pc.r, pc.g, pc.b)
				track(sw.MouseButton1Click:Connect(function()
					if self._dead or not self._open then
						return
					end
					value = { h = ph, s = ps, v = pv, a = value.a }
					self:_render()
					fireChanged()
					fireCommit()
				end))
				px += SWATCH + 4
			end
			y += SWATCH + 4
		end

		-- -- Drag wiring (shared pattern per surface) --
		local dragging: string? = nil
		local function fracOf(box: any, x: number): number
			local w = box.AbsoluteSize.X
			if w <= 0 then
				return 0
			end
			return Util.clamp((x - box.AbsolutePosition.X) / w, 0, 1)
		end
		local function applySurface(which: string, x: number, py: number?)
			if which == "sv" then
				local hgt = svBox.AbsoluteSize.Y
				local vv = 1
				if hgt > 0 and py ~= nil then
					vv = Util.clamp(1 - (py - svBox.AbsolutePosition.Y) / hgt, 0, 1)
				end
				value = { h = value.h, s = fracOf(svBox, x), v = vv, a = value.a }
			elseif which == "hue" then
				value = { h = fracOf(hueBox, x), s = value.s, v = value.v, a = value.a }
			elseif which == "bright" then
				value = { h = value.h, s = value.s, v = fracOf(brightBox, x), a = value.a }
			elseif which == "alpha" then
				value = { h = value.h, s = value.s, v = value.v, a = fracOf(alphaBox, x) }
			end
			self:_render()
			fireChanged()
		end
		local function grabBegin(which: string, input: any)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				dragging = which
				applySurface(which, input.Position.X, input.Position.Y)
			end
		end
		track(svGrab.InputBegan:Connect(function(input: any)
			grabBegin("sv", input)
		end))
		track(hueGrab.InputBegan:Connect(function(input: any)
			grabBegin("hue", input)
		end))
		track(brightGrab.InputBegan:Connect(function(input: any)
			grabBegin("bright", input)
		end))
		track(alphaGrab.InputBegan:Connect(function(input: any)
			grabBegin("alpha", input)
		end))
		track(s.uis.InputChanged:Connect(function(input: any)
			if self._dead or dragging == nil then
				return
			end
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
				applySurface(dragging :: string, input.Position.X, input.Position.Y)
			end
		end))
		track(s.uis.InputEnded:Connect(function(input: any)
			if dragging == nil then
				return
			end
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				dragging = nil
				fireCommit()
			end
		end))
		track(s.uis.InputBegan:Connect(function(input: any)
			if self._open and not self._dead and input.KeyCode == Enum.KeyCode.Escape then
				self:close()
			end
		end))

		-- Hex commit.
		track(hexBox.Focused:Connect(function()
			nodes.hexTyping = true
		end))
		track(hexBox.FocusLost:Connect(function(_enter: boolean)
			nodes.hexTyping = false
			if self._dead or not self._open then
				return
			end
			local parsed = Color.fromHex(hexBox.Text)
			if parsed ~= nil then
				local h2, s2, v2 = Color.rgbToHsv(parsed.r, parsed.g, parsed.b)
				value = { h = h2, s = s2, v = v2, a = Color.clamp01(parsed.a) }
				self:_render()
				fireChanged()
				fireCommit()
			else
				self:_render() -- revert to the committed value
			end
		end))

		self:_render()
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- close/destroy --
	function picker.close(self: any)
		if not self._open then
			return
		end
		self._open = false
		for _, c in ipairs(self._conns) do
			pcall(function()
				local conn: any = c
				conn:Disconnect()
			end)
		end
		table.clear(self._conns)
		if root ~= nil then
			pcall(function()
				root:Destroy()
			end)
			root = nil
		end
		nodes = {}
		if onCloseCb ~= nil then
			onCloseCb()
		end
	end

	function picker.destroy(self: any)
		if self._dead then
			return
		end
		self._dead = true
		self:close()
	end

	return picker
end

return ColorPicker
end)()
__PRISM_MODULES["Panel"] = (function()
-- ============================================================================
--  PRISM-UI · Panel (the Visuals tab)
-- ----------------------------------------------------------------------------
--  Generates the entire settings interface from Schema: search, sections,
--  standalone rows, collapsible groups with per-option sub-settings (dimmed
--  while their master toggle is off), config import/export/reset, live
--  search filtering and an empty state.
--
--  STORE WIRING: every widget is controlled — user gestures write through
--  `store:set` (rejected writes push the kept value back into the widget),
--  and one global subscription pushes external changes (undo, profiles,
--  imports) down into the widgets. `config.profile` is special-cased to
--  `store:applyProfile` so one click swaps the whole state in a single
--  undo step.
-- ============================================================================

local Color = __PRISM_REQUIRE("Color")
local ColorPicker = __PRISM_REQUIRE("ColorPicker")
local Schema = __PRISM_REQUIRE("Schema")
local Theme = __PRISM_REQUIRE("Theme")
local Util = __PRISM_REQUIRE("Util")
local Widgets = __PRISM_REQUIRE("Widgets")

local Panel = {}

function Panel.new(props: any, parent: any): any
	props = props or {}
	local store = props.store
	assert(store ~= nil, "Panel requires props.store")
	local overlay = props.overlay
	assert(overlay ~= nil, "Panel requires props.overlay (popup layer)")
	local notifyOverride = props.notify
	local function notify(msg: string)
		if notifyOverride then
			local run = notifyOverride
			run(msg)
		else
			print("[PRISM] " .. msg)
		end
	end
	local tokens = Theme.current()

	local function el(class: string, elProps: { [string]: any }?, elParent: any?): any
		local o = Instance.new(class)
		if elProps ~= nil then
			for k, v in pairs(elProps) do
				(o :: any)[k] = v
			end
		end
		o.Parent = elParent
		return o
	end

	--- Theme token name -> engine Color3.
	local function c3hex(tokenName: string): any
		local parsed = Color.fromHex(Theme.get(tokenName)) or { r = 1, g = 1, b = 1, a = 1 }
		local ir, ig, ib = Color.toRGB255(parsed.r, parsed.g, parsed.b)
		return Color3.fromRGB(ir, ig, ib)
	end

	local root = el("Frame", {
		Name = "VisualsPanel",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
	}, parent)

	local panel: any = { root = root, store = store }
	local handles: { [string]: any } = {}
	local refreshers: { () -> () } = {}
	local descRefs: { any } = {}
	local orderCounter = 0
	local function nextOrder(): number
		orderCounter += 1
		return orderCounter
	end
	-- Search model.
	local sections: { any } = {}
	local groupToggleMap: { [string]: any } = {}

	local function trackRefresher(h: any)
		table.insert(refreshers, function()
			-- NOTE: boolean alias on purpose -- refining h._refresh in the
			-- condition directly makes luau-analyze mistype the call below.
			local hasRefresh = h._refresh ~= nil
			if hasRefresh then
				h:_refresh()
			end
		end)
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- search box --
	local searchHandle = Widgets.Searchbox({ placeholder = "Search settings..." }, root)
	searchHandle.root.LayoutOrder = nextOrder()
	trackRefresher(searchHandle)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- scroll content --
	local scroll = el("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 38),
		Size = UDim2.new(1, 0, 1, -38),
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, root)
	local content = el("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, scroll)
	local contentLayout = el("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, content)
	contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 8)
	end)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- writers --
	local function makeWriter(field: Schema.Field, handleRef: { h: any })
		return function(v: any)
			if field.key == "config.profile" then
				store:applyProfile(v)
				notify("Profile applied: " .. tostring(v))
				return
			end
			local ok, err = store:set(field.key, v)
			if not ok then
				-- Rejected (e.g. multi-select minimum): restore the kept value.
				if handleRef.h ~= nil then
					handleRef.h:set(store:get(field.key))
				end
				notify("Couldn't apply: " .. tostring(err))
			end
		end
	end

	local function buildField(field: Schema.Field, fieldParent: any): any
		local ref: { h: any } = { h = nil }
		local writer = makeWriter(field, ref)
		local common = {
			label = field.label,
			description = field.description,
			value = store:get(field.key),
			onChanged = writer,
		}
		local h: any = nil
		if field.kind == "toggle" then
			h = Widgets.Toggle(common, fieldParent)
		elseif field.kind == "slider" then
			common.min = field.min
			common.max = field.max
			common.step = field.step
			common.unit = field.unit
			common.decimals = field.decimals
			h = Widgets.Slider(common, fieldParent)
		elseif field.kind == "dropdown" then
			common.options = field.options
			common.multi = field.multi
			common.minSelect = field.minSelect
			common.maxSelect = field.maxSelect
			common.overlay = overlay
			h = Widgets.Dropdown(common, fieldParent)
		elseif field.kind == "keybind" then
			common.allowMouse = field.allowMouse
			h = Widgets.Keybind(common, fieldParent)
		elseif field.kind == "color" then
			common.overlay = overlay
			common.picker = ColorPicker
			common.onCommit = function()
				store:flushAutosave()
			end
			h = Widgets.ColorField(common, fieldParent)
		else
			error("Panel: unknown field kind '" .. tostring(field.kind) .. "'")
		end
		ref.h = h
		h.root.LayoutOrder = nextOrder()
		h.root.Name = "Row_" .. field.key
		handles[field.key] = h
		trackRefresher(h)
		local desc = h.root:FindFirstChild("Desc")
		if desc ~= nil then
			table.insert(descRefs, desc)
		end
		return h
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- groups --
	local function buildGroup(group: Schema.Group, sectionBody: any): any
		local card = el("Frame", {
			Name = "Group_" .. group.id,
			BackgroundColor3 = c3hex("bg2"),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(),
		}, sectionBody)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusMd) }, card)
		local cardStroke = el("UIStroke", { Color = c3hex("border"), Thickness = 1 }, card)
		el("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 0),
		}, card)
		local hasDesc = group.description ~= nil and group.description ~= ""
		local header = el("TextButton", {
			Name = "Header",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, hasDesc and 46 or 34),
			LayoutOrder = 1,
		}, card)
		local headerChev = el("TextLabel", {
			Name = "Chevron",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 0),
			Size = UDim2.new(0, 16, 0, hasDesc and 26 or 34),
			Font = Enum.Font[tokens.fontRegular],
			TextSize = 11,
			TextColor3 = c3hex("textDim"),
			Text = "▲",
		}, header)
		local headerLabel = el("TextLabel", {
			Name = "Title",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 28, 0, hasDesc and 5 or 0),
			Size = UDim2.new(1, -84, 0, 18),
			Font = Enum.Font[tokens.fontMedium],
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = c3hex("text"),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = group.label,
		}, header)
		local headerDesc: any = nil
		if hasDesc then
			headerDesc = el("TextLabel", {
				Name = "Desc",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 28, 0, 23),
				Size = UDim2.new(1, -84, 0, 16),
				Font = Enum.Font[tokens.fontRegular],
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = c3hex("textDim"),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = group.description,
			}, header)
			table.insert(descRefs, headerDesc)
		end

		-- Registered after the header exists (the closure captures locals).
		table.insert(refreshers, function()
			card.BackgroundColor3 = c3hex("bg2")
			cardStroke.Color = c3hex("border")
			headerLabel.TextColor3 = c3hex("text")
			if headerDesc ~= nil then
				headerDesc.TextColor3 = c3hex("textDim")
			end
			headerChev.TextColor3 = c3hex("textDim")
		end)

		local kids = el("Frame", {
			Name = "Children",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
		}, card)
		el("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}, kids)
		el("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 8),
		}, kids)

		-- Children first (the master toggle wires into them).
		local childEntries: { any } = {}
		local childHandles: { any } = {}
		for _, childKey in ipairs(group.children) do
			local field = Schema.get(childKey) :: Schema.Field
			local h = buildField(field, kids)
			table.insert(childEntries, { key = childKey, root = h.root })
			table.insert(childHandles, h)
		end

		local toggleField = Schema.get(group.toggle) :: Schema.Field
		local toggleRef: { h: any } = { h = nil }
		local baseWriter = makeWriter(toggleField, toggleRef)
		local master = Widgets.Toggle({
			label = nil,
			description = nil,
			value = store:get(group.toggle),
			onChanged = function(v: any)
				baseWriter(v)
				for _, ch in ipairs(childHandles) do
					ch:enable(v == true)
				end
			end,
		}, header)
		toggleRef.h = master
		master.root.AnchorPoint = Vector2.new(1, 0.5)
		master.root.Position = UDim2.new(1, -10, 0, hasDesc and 23 or 17)
		master.root.Size = UDim2.new(0, 48, 0, 30)
		master.root.Name = "Row_" .. group.toggle
		handles[group.toggle] = master
		trackRefresher(master)
		groupToggleMap[group.toggle] = { children = childHandles }
		if not store:get(group.toggle) then
			for _, ch in ipairs(childHandles) do
				ch:enable(false)
			end
		end

		local collapsed = false
		header.MouseButton1Click:Connect(function()
			collapsed = not collapsed
			kids.Visible = not collapsed
			headerChev.Text = collapsed and "▼" or "▲"
		end)

		return {
			id = group.id,
			label = group.label,
			card = card,
			headerRoot = master.root,
			children = childEntries,
		}
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- sections --
	for _, section in ipairs(Schema.SECTIONS) do
		local secHandle = Widgets.Section({ title = section.title, hint = section.hint }, content)
		secHandle.root.LayoutOrder = nextOrder()
		trackRefresher(secHandle)
		local body = secHandle:content()
		local secModel: any = { root = secHandle.root, rows = {}, groups = {} }
		for _, field in ipairs(Schema.standaloneFields(section.id)) do
			local h = buildField(field, body)
			table.insert(secModel.rows, { key = field.key, root = h.root })
		end
		for _, group in ipairs(Schema.groupsInSection(section.id)) do
			local g = buildGroup(group, body)
			table.insert(secModel.groups, g)
		end
		-- Config extras live at the end of the Config section.
		if section.id == "config" then
			local importBox = Widgets.Textbox({
				label = "Config JSON",
				placeholder = "Export copies here — paste to import...",
				mono = true,
				clearOnFocus = false,
			}, body)
			importBox.root.LayoutOrder = nextOrder()
			trackRefresher(importBox)
			local btnRow = el("Frame", {
				Name = "ConfigButtons",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 32),
				LayoutOrder = nextOrder(),
			}, body)
			local function third(i: number): any
				return el("Frame", {
					BackgroundTransparency = 1,
					Position = UDim2.new((i - 1) / 3, 0, 0, 0),
					Size = UDim2.new(1 / 3, 0, 1, 0),
				}, btnRow)
			end
			local httpService = game:GetService("HttpService")
			local copyBtn = Widgets.Button({
				text = "Copy JSON",
				variant = "ghost",
				onClick = function()
					local json = httpService:JSONEncode(store:export())
					importBox:set(json)
					local clip = setclipboard
					if clip ~= nil then
						local ok = pcall(clip, json)
						notify(ok and "Config copied to clipboard." or "Clipboard failed — JSON is in the box.")
					else
						notify("Clipboard unavailable — JSON is in the box.")
					end
				end,
			}, third(1))
			local importBtn = Widgets.Button({
				text = "Import",
				variant = "ghost",
				onClick = function()
					local text = importBox:get()
					local ok, data = pcall(function()
						return httpService:JSONDecode(text)
					end)
					if not ok or type(data) ~= "table" then
						notify("Import failed: not valid JSON.")
						return
					end
					local warnings = store:import(data)
					if #warnings == 0 then
						notify("Imported config.")
					else
						notify("Imported with " .. #warnings .. " warning(s).")
					end
					importBox:set("")
				end,
			}, third(2))
			local resetBtn = Widgets.Button({
				text = "Reset all",
				variant = "danger",
				onClick = function()
					store:reset()
					notify("Defaults restored.")
				end,
			}, third(3))
			trackRefresher(copyBtn)
			trackRefresher(importBtn)
			trackRefresher(resetBtn)
			panel._copyBtn = copyBtn
			panel._importBtn = importBtn
			panel._resetBtn = resetBtn
			panel._importBox = importBox
		end
		table.insert(sections, secModel)
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- footer + empty state --
	local versionText = "PRISM-UI v" .. tostring(props.version or "1.0.0")
		.. " · " .. tostring(#Schema.FIELDS) .. " settings"
	local footer = el("TextLabel", {
		Name = "Footer",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = nextOrder(),
		Font = Enum.Font[tokens.fontRegular],
		TextSize = 10,
		TextColor3 = c3hex("textFaint"),
		Text = versionText,
	}, content)
	table.insert(refreshers, function()
		footer.TextColor3 = c3hex("textFaint")
	end)
	local emptyState = el("TextLabel", {
		Name = "EmptyState",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 60),
		LayoutOrder = nextOrder(),
		Font = Enum.Font[tokens.fontRegular],
		TextSize = 13,
		TextColor3 = c3hex("textDim"),
		Text = "No settings match your search.",
		Visible = false,
	}, content)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- search --
	local searchDebouncer = Util.debounce(function(q: string)
		local query = string.match(q or "", "^%s*(.-)%s*$") or ""
		if query == "" then
			for _, sec in ipairs(sections) do
				sec.root.Visible = true
				for _, row in ipairs(sec.rows) do
					row.root.Visible = true
				end
				for _, g in ipairs(sec.groups) do
					g.card.Visible = true
					g.headerRoot.Visible = true
					for _, child in ipairs(g.children) do
						child.root.Visible = true
					end
				end
			end
			emptyState.Visible = false
			return
		end
		local hitSet: { [string]: boolean } = {}
		for _, hit in ipairs(Schema.searchFields(query)) do
			hitSet[hit.field.key] = true
		end
		local gitems: { Util.SearchItem } = {}
		for _, group in ipairs(Schema.GROUPS) do
			table.insert(gitems, {
				id = group.id,
				text = group.label .. " " .. (group.description or ""),
			})
		end
		local gmatch: { [string]: boolean } = {}
		for _, ghit in ipairs(Util.rankedSearch(gitems, query)) do
			gmatch[ghit.id] = true
		end
		local anyVisible = false
		for _, sec in ipairs(sections) do
			local secVisible = false
			for _, row in ipairs(sec.rows) do
				local vis = hitSet[row.key] == true
				row.root.Visible = vis
				secVisible = secVisible or vis
			end
			for _, g in ipairs(sec.groups) do
				if gmatch[g.id] then
					g.card.Visible = true
					g.headerRoot.Visible = true
					for _, child in ipairs(g.children) do
						child.root.Visible = true
					end
					secVisible = true
				else
					local anyChild = false
					for _, child in ipairs(g.children) do
						local vis = hitSet[child.key] == true
						child.root.Visible = vis
						anyChild = anyChild or vis
					end
					-- The master toggle doubles as the group header row.
					local toggleKey = string.sub(g.headerRoot.Name, 5) -- strip "Row_"
					local headerVis = anyChild or hitSet[toggleKey] == true
					g.headerRoot.Visible = headerVis
					g.card.Visible = anyChild or headerVis
					secVisible = secVisible or g.card.Visible
				end
			end
			sec.root.Visible = secVisible
			anyVisible = anyVisible or secVisible
		end
		emptyState.Visible = not anyVisible
	end, props.searchDebounce or 0.15)
	searchHandle:onChanged(function(q: string)
		searchDebouncer.call(q)
	end)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- store -> widgets --
	local unsubscribe = store:subscribe(nil, function(key: string, newV: any)
		local hd = handles[key]
		if hd ~= nil then
			hd:set(newV)
		end
		local g = groupToggleMap[key]
		if g ~= nil then
			for _, ch in ipairs(g.children) do
				local child: any = ch
				child:enable(newV == true)
			end
		end
	end)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- public API --
	panel.handles = handles

	function panel.search(self: any, q: string)
		searchHandle:set(q)
		searchDebouncer.call(q)
	end

	function panel.flushSearch(self: any)
		searchDebouncer.flush()
	end

	function panel.setTooltips(self: any, on: boolean)
		for _, desc in ipairs(descRefs) do
			desc.Visible = on
		end
	end

	function panel.refreshTheme(self: any)
		tokens = Theme.current()
		for _, fn in ipairs(refreshers) do
			fn()
		end
	end

	function panel.destroy(self: any)
		if self._dead then
			return
		end
		self._dead = true
		searchDebouncer.cancel()
		unsubscribe()
		for _, hd in pairs(handles) do
			pcall(function()
				hd:destroy()
			end)
		end
		pcall(function()
			searchHandle:destroy()
		end)
		pcall(function()
			root:Destroy()
		end)
	end

	return panel
end

return Panel
end)()
__PRISM_MODULES["Window"] = (function()
-- ============================================================================
--  PRISM-UI · Window
-- ----------------------------------------------------------------------------
--  Application chrome: ScreenGui + ambient scale, draggable center card,
--  title bar (drag, minimize, hide), sidebar tabs, content area, a topmost
--  overlay layer (dropdowns, pickers, toasts), toast notifications, corner
--  resize and UI-scale support.
--
--  The window is deliberately store-agnostic: hosts drive visibility, scale
--  and theme through the methods below (Init wires them to the store).
-- ============================================================================

local Color = __PRISM_REQUIRE("Color")
local Theme = __PRISM_REQUIRE("Theme")
local Util = __PRISM_REQUIRE("Util")

local Window = {}

local cachedServices: any = nil
local function services(): any
	if cachedServices == nil then
		local g = game
		cachedServices = {
			tween = g:GetService("TweenService"),
			uis = g:GetService("UserInputService"),
		}
	end
	return cachedServices
end

local function c3hex(tokenName: string): any
	local parsed = Color.fromHex(Theme.get(tokenName)) or { r = 1, g = 1, b = 1, a = 1 }
	local ir, ig, ib = Color.toRGB255(parsed.r, parsed.g, parsed.b)
	return Color3.fromRGB(ir, ig, ib)
end

local function el(class: string, props: { [string]: any }?, parent: any?): any
	local o = Instance.new(class)
	if props ~= nil then
		for k, v in pairs(props) do
			(o :: any)[k] = v
		end
	end
	o.Parent = parent
	return o
end

function Window.new(props: any): any
	props = props or {}
	local onToggleCb = props.onToggle
	local parent = props.parent
	assert(parent ~= nil, "Window requires props.parent (a Gui container)")
	local tokens = Theme.current()
	local s = services()
	local W = props.width or 640
	local H = props.height or 620
	local SIDEBAR = 150

	local gui = el("ScreenGui", {
		Name = props.name or "PRISM",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent)

	-- Full-screen root so a UIScale can zoom the whole app at once.
	local root = el("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, gui)
	local rootScale = el("UIScale", { Scale = props.scale or 1 }, root)

	local card = el("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = c3hex("bg1"),
		BorderSizePixel = 0,
		ClipsDescendants = false,
	}, root)
	el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusLg) }, card)
	local cardStroke = el("UIStroke", { Color = c3hex("borderStrong"), Thickness = 1 }, card)
	local popScale = el("UIScale", { Scale = 1 }, card)

	local window: any = {
		root = gui,
		_conns = {},
		_tabs = {},
		_tabOrder = {},
		_refreshers = {},
		_dead = false,
		_visible = true,
		_minimized = false,
	}
	local function track(conn: any)
		table.insert(window._conns, conn)
		return conn
	end

	local function tween(obj: any, tweenProps: { [string]: any }, secs: number?): any
		local info = TweenInfo.new(secs or tokens.tweenFast, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tw = s.tween:Create(obj, info, tweenProps)
		tw:Play()
		return tw
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- title bar --
	local titleBar = el("TextButton", {
		Name = "TitleBar",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
	}, card)
	local logo = el("Frame", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = c3hex("accent"),
		BorderSizePixel = 0,
	}, titleBar)
	el("UICorner", { CornerRadius = UDim.new(1, 0) }, logo)
	local titleLabel = el("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 32, 0, 6),
		Size = UDim2.new(1, -120, 0, 18),
		Font = Enum.Font[tokens.fontBold],
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = c3hex("text"),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = props.title or "PRISM",
	}, titleBar)
	local subtitleLabel = el("TextLabel", {
		Name = "Subtitle",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 32, 0, 24),
		Size = UDim2.new(1, -120, 0, 14),
		Font = Enum.Font[tokens.fontRegular],
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = c3hex("textDim"),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = props.subtitle or "Visuals",
	}, titleBar)
	local function titleButton(name: string, text: string, x: number): any
		return el("TextButton", {
			Name = name,
			Text = text,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			Font = Enum.Font[tokens.fontRegular],
			TextSize = 15,
			TextColor3 = c3hex("textDim"),
		}, titleBar)
	end
	local minBtn = titleButton("Minimize", "-", -44)
	local closeBtn = titleButton("Close", "×", -10)
	local titleDivider = el("Frame", {
		Name = "TitleDivider",
		Position = UDim2.new(0, 0, 0, 46),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = c3hex("border"),
		BorderSizePixel = 0,
	}, card)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- sidebar + content --
	local body = el("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 47),
		Size = UDim2.new(1, 0, 1, -47),
	}, card)
	local sidebar = el("Frame", {
		Name = "Sidebar",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, SIDEBAR, 1, 0),
	}, body)
	el("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	}, sidebar)
	local _sideList = el("UIListLayout", {
		Name = "SideList",
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, sidebar)
	-- (_sideList is intentionally unused beyond this point.)
	local sideDivider = el("Frame", {
		Name = "SideDivider",
		Position = UDim2.new(0, SIDEBAR, 0, 10),
		Size = UDim2.new(0, 1, 1, -20),
		BackgroundColor3 = c3hex("border"),
		BorderSizePixel = 0,
	}, body)
	local contentArea = el("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, SIDEBAR + 1, 0, 0),
		Size = UDim2.new(1, -SIDEBAR - 1, 1, 0),
	}, body)
	el("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	}, contentArea)
	local versionLabel = el("TextLabel", {
		Name = "Version",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -10),
		Size = UDim2.new(0, SIDEBAR - 20, 0, 14),
		Font = Enum.Font[tokens.fontRegular],
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = c3hex("textFaint"),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "v" .. tostring(props.version or "1.0.0"),
	}, sidebar)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- overlay + toasts --
	local overlay = el("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 100,
	}, root)
	window.overlay = overlay
	local toastBin = el("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 280, 1, -32),
		ZIndex = 400,
	}, overlay)
	el("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
	}, toastBin)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- resize grip --
	local grip = el("TextButton", {
		Name = "ResizeGrip",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		Size = UDim2.fromOffset(22, 22),
	}, card)
	-- A tiny diagonal hint (two short bars).
	el("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -6, 1, -6),
		Size = UDim2.fromOffset(10, 2),
		Rotation = -45,
		BackgroundColor3 = c3hex("borderStrong"),
		BorderSizePixel = 0,
	}, grip)

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- behavior: drag --
	local dragging = false
	local dragStart: any = nil
	local centerStart: any = nil
	track(titleBar.InputBegan:Connect(function(input: any)
		if window._dead then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			-- Freeze the current center in offset space (no visual jump).
			local abs = card.AbsolutePosition
			local size = card.AbsoluteSize
			centerStart = Vector2.new(abs.X + size.X / 2, abs.Y + size.Y / 2)
			card.Position = UDim2.fromOffset(centerStart.X, centerStart.Y)
		end
	end))
	track(s.uis.InputChanged:Connect(function(input: any)
		if window._dead or not dragging then
			return
		end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
			return
		end
		local view = root.AbsoluteSize
		local dx = input.Position.X - dragStart.X
		local dy = input.Position.Y - dragStart.Y
		-- Keep the card center inside the viewport (never lose the window).
		local cx = Util.clamp(centerStart.X + dx, 0, math.max(view.X, 1))
		local cy = Util.clamp(centerStart.Y + dy, 0, math.max(view.Y, 1))
		card.Position = UDim2.fromOffset(cx, cy)
	end))
	track(s.uis.InputEnded:Connect(function(input: any)
		if not dragging then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- behavior: resize --
	local resizing = false
	local resizeStart: any = nil
	local sizeStart: any = nil
	track(grip.InputBegan:Connect(function(input: any)
		if window._dead or window._minimized then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			resizing = true
			resizeStart = input.Position
			sizeStart = card.AbsoluteSize
		end
	end))
	track(s.uis.InputChanged:Connect(function(input: any)
		if window._dead or not resizing then
			return
		end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
			return
		end
		local w = Util.clamp(sizeStart.X + (input.Position.X - resizeStart.X), 480, 860)
		local h = Util.clamp(sizeStart.Y + (input.Position.Y - resizeStart.Y), 420, 920)
		card.Size = UDim2.fromOffset(w, h)
	end))
	track(s.uis.InputEnded:Connect(function(input: any)
		if not resizing then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			resizing = false
		end
	end))

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- tabs --
	local activeTab: string? = nil
	local function paintTabButton(btn: any, active: boolean)
		local label = btn:FindFirstChild("Label")
		local bar = btn:FindFirstChild("Bar")
		btn.BackgroundColor3 = active and c3hex("bg3") or c3hex("bg1")
		btn.BackgroundTransparency = active and 0 or 1
		if label ~= nil then
			label.TextColor3 = active and c3hex("text") or c3hex("textDim")
		end
		if bar ~= nil then
			bar.Visible = active
		end
	end

	function window.addTab(self: any, name: string): any
		assert(self._tabs[name] == nil, "Window: duplicate tab '" .. name .. "'")
		local order = #self._tabOrder + 1
		local btn = el("TextButton", {
			Name = "Tab_" .. name,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = order,
		}, sidebar)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, btn)
		local bar = el("Frame", {
			Name = "Bar",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 3, 0, 18),
			BackgroundColor3 = c3hex("accent"),
			BorderSizePixel = 0,
			Visible = false,
		}, btn)
		el("UICorner", { CornerRadius = UDim.new(0, 2) }, bar)
		el("TextLabel", {
			Name = "Label",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 12, 0, 0),
			Size = UDim2.new(1, -16, 1, 0),
			Font = Enum.Font[tokens.fontMedium],
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = c3hex("textDim"),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = name,
		}, btn)
		local page = el("Frame", {
			Name = "Page_" .. name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
		}, contentArea)
		self._tabs[name] = { button = btn, page = page }
		table.insert(self._tabOrder, name)
		track(btn.MouseButton1Click:Connect(function()
			if not self._dead then
				self:setTab(name)
			end
		end))
		track(btn.MouseEnter:Connect(function()
			if not self._dead and activeTab ~= name then
				tween(btn, { BackgroundTransparency = 0, BackgroundColor3 = c3hex("bg2") }, 0.1)
			end
		end))
		track(btn.MouseLeave:Connect(function()
			if not self._dead and activeTab ~= name then
				paintTabButton(btn, false)
			end
		end))
		table.insert(self._refreshers, function()
			paintTabButton(btn, activeTab == name)
			local lbl = btn:FindFirstChild("Label")
			if lbl ~= nil then
				lbl.Font = Enum.Font[Theme.current().fontMedium]
			end
		end)
		if activeTab == nil then
			self:setTab(name)
		end
		return page
	end

	function window.setTab(self: any, name: string)
		assert(self._tabs[name] ~= nil, "Window: unknown tab '" .. name .. "'")
		activeTab = name
		for tabName, tab in pairs(self._tabs) do
			local on = tabName == name
			tab.page.Visible = on
			paintTabButton(tab.button, on)
		end
	end

	function window.activeTabName(self: any): string?
		return activeTab
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- visibility / scale / theme --
	function window.setVisible(self: any, v: boolean)
		if self._dead then
			return
		end
		self._visible = v == true
		card.Visible = self._visible
		if self._visible then
			popScale.Scale = 0.97
			tween(popScale, { Scale = 1 }, tokens.tweenMed)
		end
		if onToggleCb ~= nil then
			onToggleCb(self._visible)
		end
	end

	function window.toggle(self: any)
		self:setVisible(not self._visible)
	end

	function window.isVisible(self: any): boolean
		return self._visible
	end

	function window.setMinimized(self: any, m: boolean)
		if self._dead then
			return
		end
		self._minimized = m == true
		body.Visible = not self._minimized
		minBtn.Text = self._minimized and "+" or "-"
	end

	function window.setScale(self: any, scaleValue: number)
		rootScale.Scale = Util.clamp(scaleValue, 0.5, 2)
	end

	function window.getScale(self: any): number
		return rootScale.Scale
	end

	function window.registerRefresher(self: any, fn: () -> ())
		table.insert(self._refreshers, fn)
	end

	function window.applyTheme(self: any)
		if self._dead then
			return
		end
		tokens = Theme.current()
		card.BackgroundColor3 = c3hex("bg1")
		cardStroke.Color = c3hex("borderStrong")
		logo.BackgroundColor3 = c3hex("accent")
		titleLabel.TextColor3 = c3hex("text")
		subtitleLabel.TextColor3 = c3hex("textDim")
		minBtn.TextColor3 = c3hex("textDim")
		closeBtn.TextColor3 = c3hex("textDim")
		titleDivider.BackgroundColor3 = c3hex("border")
		sideDivider.BackgroundColor3 = c3hex("border")
		versionLabel.TextColor3 = c3hex("textFaint")
		for _, fn in ipairs(self._refreshers) do
			local f: any = fn
			f()
		end
	end

	track(minBtn.MouseButton1Click:Connect(function()
		if not window._dead then
			window:setMinimized(not window._minimized)
		end
	end))
	track(closeBtn.MouseButton1Click:Connect(function()
		if not window._dead then
			window:setVisible(false)
		end
	end))
	if props.toggleKey ~= nil then
		track(s.uis.InputBegan:Connect(function(input: any, gameProcessed: boolean?)
			if window._dead or gameProcessed then
				return
			end
			if s.uis:GetFocusedTextBox() ~= nil then
				return
			end
			if input.KeyCode ~= nil and input.KeyCode.Name == props.toggleKey then
				window:toggle()
			end
		end))
	end

	-- -- -- -- -- -- -- -- -- -- -- -- -- -- toasts --
	local toastOrder = 0
	function window.notify(self: any, text: string)
		if self._dead then
			return
		end
		-- Cap the stack: drop the oldest toast beyond 4.
		local kids = toastBin:GetChildren()
		local count = 0
		for _, ch in ipairs(kids) do
			if ch:IsA("Frame") then
				count += 1
			end
		end
		if count >= 4 then
			local oldest: any = nil
			for _, ch in ipairs(kids) do
				if ch:IsA("Frame") and (oldest == nil or ch.LayoutOrder < oldest.LayoutOrder) then
					oldest = ch
				end
			end
			if oldest ~= nil then
				oldest:Destroy()
			end
		end
		toastOrder += 1
		local toast = el("Frame", {
			Name = "Toast",
			BackgroundColor3 = c3hex("bg2"),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 38),
			LayoutOrder = toastOrder,
			ZIndex = 401,
		}, toastBin)
		el("UICorner", { CornerRadius = UDim.new(0, tokens.radiusSm) }, toast)
		el("UIStroke", { Color = c3hex("border"), Thickness = 1 }, toast)
		el("Frame", {
			Name = "Bar",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 3, 0, 22),
			BackgroundColor3 = c3hex("accent"),
			BorderSizePixel = 0,
			ZIndex = 402,
		}, toast)
		el("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 0),
			Size = UDim2.new(1, -16, 1, 0),
			Font = Enum.Font[tokens.fontRegular],
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = c3hex("text"),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = text,
			ZIndex = 402,
		}, toast)
		toast.BackgroundTransparency = 1
		tween(toast, { BackgroundTransparency = 0 }, tokens.tweenFast)
		-- Auto-dismiss when a scheduler exists (Roblox always has `task`;
		-- scheduler-less embeds keep the toast until the window closes).
		local scheduler: any = task
		if scheduler ~= nil and type(scheduler.delay) == "function" then
			local delayFn: any = scheduler.delay
			delayFn(2.5, function()
				if window._dead then
					return
				end
				pcall(function()
					toast:Destroy()
				end)
			end)
		end
	end

	function window.destroy(self: any)
		if self._dead then
			return
		end
		self._dead = true
		for _, c in ipairs(self._conns) do
			pcall(function()
				local conn: any = c
				conn:Disconnect()
			end)
		end
		pcall(function()
			gui:Destroy()
		end)
	end

	return window
end

return Window
end)()
__PRISM_MODULES["Init"] = (function()
-- ============================================================================
--  PRISM-UI · Init (public entry point)
-- ----------------------------------------------------------------------------
--  Usage (executor):
--
--      local PRISM = loadstring(readfile("PRISM.luau"))()  -- or paste the file
--      local app = PRISM.new({ profile = "Legit" })
--      app:toggle()          -- show / hide
--      app:setProfile("Rage")
--      app.store:get("esp.enabled")
--      app:destroy()
--
--  Re-executing destroys the previous app first (no duplicate windows).
--  Persistence uses executor file IO when present (writefile/readfile/
--  isfile/makefolder); otherwise the app runs session-only and the Config
--  tab's Copy/Import covers saving through the clipboard.
-- ============================================================================

local Color = __PRISM_REQUIRE("Color")
local ColorPicker = __PRISM_REQUIRE("ColorPicker")
local Panel = __PRISM_REQUIRE("Panel")
local Schema = __PRISM_REQUIRE("Schema")
local Signal = __PRISM_REQUIRE("Signal")
local Store = __PRISM_REQUIRE("Store")
local Theme = __PRISM_REQUIRE("Theme")
local Util = __PRISM_REQUIRE("Util")
local Widgets = __PRISM_REQUIRE("Widgets")
local Window = __PRISM_REQUIRE("Window")

local PRISM = {
	_VERSION = "1.0.0",
	Color = Color,
	ColorPicker = ColorPicker,
	Panel = Panel,
	Schema = Schema,
	Signal = Signal,
	Store = Store,
	Theme = Theme,
	Util = Util,
	Widgets = Widgets,
	Window = Window,
}

--- Resolve the best available Gui container.
local function resolveParent(explicit: any): any
	if explicit ~= nil then
		return explicit
	end
	local g = game
	-- 1. Executor hui (survives PlayerGui clears, hidden from screenshots
	--    in some environments).
	local gethuiFn = gethui
	if gethuiFn ~= nil then
		local ok, h = pcall(gethuiFn)
		if ok and h ~= nil then
			return h
		end
	end
	-- 2. CoreGui (plugins / Studio / some executors).
	local okCore, core = pcall(function()
		return g:GetService("CoreGui")
	end)
	if okCore and core ~= nil then
		return core
	end
	-- 3. PlayerGui (last resort; cleared on respawn unless ResetOnSpawn=false).
	local players = g:GetService("Players")
	local plr = players.LocalPlayer
	if plr ~= nil then
		local pg = plr:FindFirstChild("PlayerGui")
		if pg ~= nil then
			return pg
		end
	end
	error("PRISM: no Gui container available (need gethui, CoreGui or PlayerGui)")
end

function PRISM.new(opts: any): any
	opts = opts or {}
	local g = game
	local uis = g:GetService("UserInputService")

	-- Tear down a previous incarnation (safe re-execution).
	local G: any = _G
	if G.__PRISM_APP ~= nil then
		pcall(function()
			(G.__PRISM_APP :: any):destroy()
		end)
		G.__PRISM_APP = nil
	end

	-- -- Store (profile seeds the defaults; disk wins when present) --
	local store = Store.new(Schema.profileState(opts.profile or "Default"))

	-- -- Persistence adapter (executor file IO when present) --
	local canPersist = writefile ~= nil and readfile ~= nil and isfile ~= nil
	local saveFolder = opts.saveFolder or "prism"
	local saveFile = opts.saveFile or "config.json"
	local savePath = saveFolder .. "/" .. saveFile
	local httpService: any = nil
	pcall(function()
		httpService = g:GetService("HttpService")
	end)

	local function writeDisk(state: { [string]: any }): boolean
		if not canPersist or httpService == nil then
			return false
		end
		local ok = pcall(function()
			if makefolder ~= nil then
				pcall(makefolder, saveFolder)
			end
			writefile(savePath, httpService:JSONEncode(state))
		end)
		return ok
	end

	local function readDisk(): ({ [string]: any }?, string?)
		if not canPersist or httpService == nil then
			return nil, "no file IO"
		end
		local okExists, exists = pcall(isfile, savePath)
		if not okExists or not exists then
			return nil, "no save file"
		end
		local okRead, text = pcall(readfile, savePath)
		if not okRead or type(text) ~= "string" then
			return nil, "unreadable save file"
		end
		local okJson, data = pcall(function()
			return httpService:JSONDecode(text)
		end)
		if not okJson or type(data) ~= "table" then
			return nil, "corrupt save file"
		end
		return data, nil
	end

	if opts.autoSave ~= false then
		store:setAutosave(function(state: { [string]: any })
			if store:get("config.autoSave") then
				writeDisk(state)
			end
		end)
	end
	-- Disk wins over the profile seed (migrated, so old saves stay valid).
	local diskState, _diskErr = readDisk()
	if diskState ~= nil then
		store:import(diskState)
	end

	-- -- Window + panel --
	local parent = resolveParent(opts.parent)
	local window = Window.new({
		parent = parent,
		title = opts.title or "PRISM",
		subtitle = opts.subtitle or "Visuals",
		version = PRISM._VERSION,
		width = opts.width,
		height = opts.height,
	})
	local page = window:addTab("Visuals")
	local panel = Panel.new({
		store = store,
		overlay = window.overlay,
		version = PRISM._VERSION,
		notify = function(msg: string)
			window:notify(msg)
		end,
	}, page)
	window:registerRefresher(function()
		panel:refreshTheme()
	end)

	-- -- Live accent: colors.accent re-themes the whole app --
	local function applyAccent()
		local c = store:get("colors.accent")
		local r, gg, b = Color.hsvToRgb(c.h, c.s, c.v)
		local hex = Color.toHex(r, gg, b)
		Theme.setToken("accent", hex)
		Theme.setToken("accentSoft", Theme.mix(hex, Theme.get("bg1"), 0.8))
		window:applyTheme()
	end
	local unsubAccent = store:subscribe("colors.accent", applyAccent)
	if opts.accentSync ~= false then
		applyAccent()
	else
		window:applyTheme()
	end

	-- -- UI scale + tooltips follow the store --
	local function applyScale()
		window:setScale(store:get("config.uiScale"))
	end
	local unsubScale = store:subscribe("config.uiScale", applyScale)
	applyScale()
	local function applyTooltips()
		panel:setTooltips(store:get("config.tooltips") == true)
	end
	local unsubTips = store:subscribe("config.tooltips", applyTooltips)
	applyTooltips()

	-- -- Global hotkeys --
	local function keyNameOf(input: any): string?
		local kc = input.KeyCode
		if kc ~= nil and kc ~= Enum.KeyCode.Unknown then
			return kc.Name
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1
			or t == Enum.UserInputType.MouseButton2
			or t == Enum.UserInputType.MouseButton3
		then
			return t.Name
		end
		return nil
	end
	local hotkeyConn = uis.InputBegan:Connect(function(input: any, gameProcessed: boolean?)
		if gameProcessed then
			return
		end
		if uis:GetFocusedTextBox() ~= nil then
			return -- don't hijack typing
		end
		local name = keyNameOf(input)
		if name == nil or name == "None" then
			return
		end
		if name == store:get("keys.toggleUI") then
			window:toggle()
		elseif name == store:get("keys.toggleESP") then
			store:set("esp.enabled", not store:get("esp.enabled"))
		elseif name == store:get("keys.toggleChams") then
			store:set("chams.enabled", not store:get("chams.enabled"))
		elseif name == store:get("keys.panic") then
			store:transaction(function(s: any)
				s:set("esp.enabled", false)
				s:set("chams.enabled", false)
			end)
			window:setVisible(false)
			window:notify("Panic: visuals off, UI hidden.")
		end
	end)

	-- -- App handle --
	local app: any = {
		store = store,
		window = window,
		panel = panel,
		version = PRISM._VERSION,
		_dead = false,
	}
	function app.toggle(self: any)
		window:toggle()
	end
	function app.setVisible(self: any, v: boolean)
		window:setVisible(v)
	end
	function app.setProfile(self: any, name: string)
		store:applyProfile(name)
		window:notify("Profile applied: " .. tostring(name))
	end
	function app.save(self: any): boolean
		store:flushAutosave()
		return writeDisk(store:export())
	end
	function app.destroy(self: any)
		if self._dead then
			return
		end
		self._dead = true
		pcall(function()
			hotkeyConn:Disconnect()
		end)
		unsubAccent()
		unsubScale()
		unsubTips()
		pcall(function()
			panel:destroy()
		end)
		pcall(function()
			window:destroy()
		end)
		pcall(function()
			store:destroy()
		end)
		if G.__PRISM_APP == self then
			G.__PRISM_APP = nil
		end
	end

	G.__PRISM_APP = app
	return app
end

return PRISM
end)()

return __PRISM_MODULES["Init"]
