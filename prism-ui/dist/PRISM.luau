		local card = el("Frame", {
			Name = "Card",
			Size = UDim2.fromOffset(CARD_W, cardH),
			BackgroundColor3 = c3(tokens.overlay),
			BorderSizePixel = 0,
			ZIndex = 301,
			ClipsDescendants = true,
		}, root)
